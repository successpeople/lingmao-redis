# Alibaba Cloud Redis — copy to .env locally; on Render → Environment

REDIS_HOST=your-instance.redis.rds.aliyuncs.com
REDIS_PORT=6379
# ACL 用户名以控制台「账号管理」为准；常见默认账号为 default（勿把实例 ID 误当用户名）
REDIS_USERNAME=default
#
# ⚠️ 密码里若有 # ; 空格 等字符，必须用双引号包住，否则 # 后半段会被解析成注释，导致 WRONGPASS
# REDIS_PASSWORD="your_password_maybe_has_#symbol"
REDIS_PASSWORD=your_redis_password

# Optional: TLS（若控制台要求 SSL 端口，通常为 6380 并设为 true）
REDIS_TLS=false

# Optional: API_KEY=...

# PORT=3000
